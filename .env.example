# Copy to .env. Values below are local defaults, not production secrets.

# postgres
POSTGRES_USER=nobarsync
POSTGRES_PASSWORD=nobarsync
POSTGRES_DB=nobarsync
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=ecto://nobarsync:nobarsync@localhost:5432/nobarsync

# phoenix
NOBARSYNC_ROLE=all
SECRET_KEY_BASE=dev-only-secret-key-base-change-me-please-0123456789abcdef
MEDIA_TOKEN_SECRET=dev-only-media-token-secret-change-me
PHX_HOST=localhost
PHX_SCHEME=http
PORT=4000
FORCE_SECURE_COOKIES=false
LOG_LEVEL=debug
WEB_ORIGIN=http://localhost:5173
EMPTY_ROOM_TTL_SECONDS=600
HOST_TRANSFER_GRACE_MS=20000
SYNC_LEAD_MS=1200
SYNC_MAX_LEAD_MS=2500

# seed accounts (development only)
SEED_ADMIN_EMAIL=admin@nobarsync.local
SEED_ADMIN_PASSWORD=nobarsync-dev
SEED_HOST_EMAIL=host@nobarsync.local
SEED_HOST_PASSWORD=nobarsync-dev

# object storage. The API speaks the S3 API.
# Defaults below are the local MinIO container. For Cloudflare R2, use the block
# commented under this one, then recreate api and worker: docker compose up -d api worker
S3_ACCESS_KEY=nobarsync
S3_SECRET_KEY=nobarsync-secret
S3_BUCKET=nobarsync
S3_REGION=us-east-1
S3_SCHEME=http://
S3_HOST=minio
S3_PORT=9000
S3_PUBLIC_SCHEME=http://
S3_PUBLIC_HOST=localhost
S3_PUBLIC_PORT=9000
MEDIA_DELIVERY=local
MEDIA_PUBLIC_BASE=http://localhost:8080

# Cloudflare R2 — uncomment and fill, then comment out the MinIO S3_* lines above.
# Create an R2 bucket and an API token with Object Read & Write.
# Presigned upload goes to the S3 endpoint, not a custom domain.
# On the bucket, add a CORS rule: allowed origins http://localhost:8080 (and your
# public site), methods PUT GET HEAD, header *, expose ETag.
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
# S3_REGION=auto
# S3_SCHEME=https://
# S3_HOST=<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_PORT=443
# S3_PUBLIC_SCHEME=https://
# S3_PUBLIC_HOST=<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_PUBLIC_PORT=443
# MEDIA_DELIVERY=local
# MEDIA_PUBLIC_BASE=http://localhost:8080
# After the media Worker is deployed, set MEDIA_TOKEN_SECRET to the same value
# as the Worker secret and point playback at that Worker.

# encode limits
ENCODE_CONCURRENCY=1
ENCODE_THREADS=2
ENCODE_TIMEOUT_MS=1800000
ENCODE_MAX_SCRATCH_BYTES=21474836480
MAX_UPLOAD_BYTES=8589934592
IMPORT_HOST_ALLOWLIST=
IMPORT_MAX_BYTES=2147483648

# optional providers (leave blank to keep them disabled)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
R2_ACCOUNT_ID=

# frontend
VITE_API_URL=

# Self-hosted coturn (docker compose --profile turn up -d turn api).
# TURN_URLS is for browsers: public hostname/IP, never the Docker service name.
# Keep it empty until TURN is reachable from your viewers' networks.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_REALM=nobarsync.local
TURN_EXTERNAL_IP=
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_TLS_ENABLED=false
# TLS: put fullchain.pem + privkey.pem in infra/turn/certs and enable TLS.
# Then add turns:turn.yourdomain.com:5349?transport=tcp to TURN_URLS.

# Start ngrok with the whole app: COMPOSE_PROFILES=tunnel then docker compose up -d.
# Alternatively: docker compose --profile tunnel up -d.
COMPOSE_PROFILES=
NGROK_AUTHTOKEN=
# Optional assigned ngrok URL. Keep blank for a newly assigned address.
NGROK_URL=
